APP_NAME=RepoSketch
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

REPO_STORAGE_DIR=backend/storage/repos
ANALYSIS_STORAGE_DIR=backend/storage/analysis
CHROMA_PERSIST_DIR=backend/storage/chroma

MAX_FILE_SIZE_KB=256
ALLOWED_CODE_EXTENSIONS=.py,.md,.txt,.json,.yaml,.yml,.toml,.ini,.cfg
INDEXABLE_EXTENSIONS=.py,.md,.txt,.json,.yaml,.yml

# Required for /analyze/index and /ask
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
