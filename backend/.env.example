APP_NAME=RepoSketch
APP_ENV=development
APP_VERSION=1.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
EXTRA_FRONTEND_ORIGINS=

REPO_STORAGE_DIR=backend/storage/repos
ANALYSIS_STORAGE_DIR=backend/storage/analysis
VECTOR_STORE_DIR=backend/storage/vectors

MAX_FILE_SIZE_KB=256
MAX_REPO_FILES=4000
MAX_REPO_SIZE_MB=400
ALLOWED_CODE_EXTENSIONS=.py,.md,.txt,.json,.yaml,.yml,.toml,.ini,.cfg
INDEXABLE_EXTENSIONS=.py,.md,.txt,.json,.yaml,.yml
INDEX_EXCLUDED_DIRECTORIES=.git,.github,node_modules,dist,build,.venv,venv,__pycache__,docs,docs_src,tests,test,testing,examples,example,benchmarks,benchmark
INDEX_EXCLUDED_FILES=changes.md,changelog.md,changes.rst,license,license.txt,license.md,notice
MAX_INDEX_CHUNKS=1200
EMBEDDING_BATCH_SIZE=32
DAILY_CREDIT_LIMIT=100
IP_DAILY_CREDIT_LIMIT=300

# Free Google Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2

VECTOR_COLLECTION_PREFIX=reposketch
